			<column name="description" value="CBHI insurance Zone (separate from residential address)"/>
			<column name="format" value="java.lang.String"/>
			<column name="searchable" valueBoolean="false"/>
			<column name="creator" valueNumeric="1"/>
			<column name="date_created" valueDate="NOW()"/>
			<column name="retired" valueBoolean="false"/>
			<column name="uuid" value="5e3c8f91-4b2a-4d6e-9c1f-a1b2c3d4e002"/>
			<column name="sort_weight" valueNumeric="0"/>
		</insert>
	</changeSet>

	<changeSet id="ethbahmnicore-2026-09-03-cbhi-woreda-attr" author="ethbahmnicore">
		<preConditions onFail="MARK_RAN">
			<sqlCheck expectedResult="0">SELECT COUNT(*) FROM person_attribute_type WHERE name = 'CBHI Woreda'</sqlCheck>
		</preConditions>
		<comment>Person attribute type: CBHI Woreda</comment>
