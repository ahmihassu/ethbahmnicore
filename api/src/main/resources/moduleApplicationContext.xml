<?xml version="1.0" encoding="UTF-8"?>

<!-- Beans to add to the current Application context definition -->

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
  		    http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

    <!-- DAOs are wired explicitly rather than component-scanned with @Autowired. By-type injection
         makes Spring enumerate and instantiate every FactoryBean in the (very large) Bahmni context
         while the module context refreshes, which stalls OpenMRS startup. -->
    <bean id="ethbahmnicore.EthioBahmniCoreDao"
            class="org.openmrs.module.ethbahmnicore.api.dao.EthioBahmniCoreDao">
        <property name="sessionFactory" ref="dbSessionFactory" />
    </bean>

    <bean id="ethbahmnicore.CbhiLocationDao" class="org.openmrs.module.ethbahmnicore.api.dao.CbhiLocationDao">
        <property name="sessionFactory" ref="dbSessionFactory" />
    </bean>

    <!-- CbhiLocation is registered with the core session factory through
         <packagesWithMappedClasses> in config.xml. Defining a child of the sessionFactory bean here
         would build a second SessionFactory and hang OpenMRS startup. -->

    <!-- Wraps EthioBahmniCoreService methods in DB transactions and OpenMRS interceptors -->
    <bean id="ethbahmnicore.EthioBahmniCoreService"
            class="org.springframework.transaction.interceptor.TransactionProxyFactoryBean">
        <property name="transactionManager">
            <ref bean="transactionManager" />
        </property>
        <property name="target">
            <bean class="org.openmrs.module.ethbahmnicore.api.impl.EthioBahmniCoreServiceImpl">
                <property name="dao" ref="ethbahmnicore.EthioBahmniCoreDao" />
            </bean>
        </property>
        <property name="preInterceptors">
            <ref bean="serviceInterceptors" />
        </property>
        <property name="transactionAttributeSource">
            <ref bean="transactionAttributeSource" />
        </property>
    </bean>

    <bean parent="serviceContext">
        <property name="moduleService">
            <list>
                <value>org.openmrs.module.ethbahmnicore.api.EthioBahmniCoreService</value>
                <ref bean="ethbahmnicore.EthioBahmniCoreService" />
            </list>
        </property>
    </bean>

    <bean id="ethbahmnicore.CbhiLocationService"
            class="org.springframework.transaction.interceptor.TransactionProxyFactoryBean">
        <property name="transactionManager">
            <ref bean="transactionManager" />
        </property>
        <property name="target">
            <bean class="org.openmrs.module.ethbahmnicore.api.impl.CbhiLocationServiceImpl">
                <property name="dao" ref="ethbahmnicore.CbhiLocationDao" />
            </bean>
        </property>
        <property name="preInterceptors">
            <ref bean="serviceInterceptors" />
        </property>
        <property name="transactionAttributeSource">
            <ref bean="transactionAttributeSource" />
        </property>
    </bean>

    <bean parent="serviceContext">
        <property name="moduleService">
            <list>
                <value>org.openmrs.module.ethbahmnicore.api.CbhiLocationService</value>
                <ref bean="ethbahmnicore.CbhiLocationService" />
            </list>
        </property>
    </bean>
</beans>
