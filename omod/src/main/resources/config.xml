<?xml version="1.0" encoding="UTF-8"?>

<module configVersion="1.2">
	
	<!-- Base Module Properties -->
	<id>${project.parent.artifactId}</id>
	<name>${project.parent.name}</name>
	<version>${project.parent.version}</version>
	<package>org.openmrs.module.ethbahmnicore</package>
	<author>ahmi</author>
	<description>
			${project.parent.description}
	</description>

	<activator>org.openmrs.module.ethbahmnicore.EthioBahmniCoreActivator</activator>
	
	<!-- /Base Module Properties -->
	
	<!-- Minimum OpenMRS 2.1.x; hospital servers may be 2.1.1 while vagrant is 2.1.7 -->
	<require_version>2.1.0</require_version>

	<require_modules>
		<!-- No version pin: hospital Bahmni may ship webservices.rest older than compile classpath -->
		<require_module>org.openmrs.module.webservices.rest</require_module>
	</require_modules>

	<aware_of_modules>
		<aware_of_module>org.openmrs.module.legacyui</aware_of_module>
	</aware_of_modules>

	<privilege>
		<name>Ethio Bahmni Core Privilege</name>
		<description>Allows managing Ethio Bahmni Core data including CBHI location import</description>
	</privilege>

	<!-- Annotated entities (CbhiLocation) added to the core Hibernate session factory -->
	<packagesWithMappedClasses>org.openmrs.module.ethbahmnicore</packagesWithMappedClasses>

	<!-- Hard enforcement: block clinical encounter/order writes without valid MRU payment.
	     VisitService is intentionally NOT advised — visit create must remain allowed. -->
	<advice>
		<point>org.openmrs.api.EncounterService</point>
		<class>org.openmrs.module.ethbahmnicore.registrationfee.advice.RegistrationFeeEncounterAdvice</class>
	</advice>
	<advice>
		<point>org.openmrs.api.OrderService</point>
		<class>org.openmrs.module.ethbahmnicore.registrationfee.advice.RegistrationFeeOrderAdvice</class>
	</advice>

	<!-- Non-secret registration-fee / Odoo connection settings (credentials via env vars) -->
	<globalProperty>
		<property>ethbahmnicore.enforceRegistrationFee</property>
		<defaultValue>false</defaultValue>
		<description>When true, ethbahmnicore denies clinical encounter/order writes without a valid MRU Registration Fee invoice for the current payment window</description>
	</globalProperty>
	<globalProperty>
		<property>ethbahmnicore.registrationFee.paymentWindowDays</property>
		<defaultValue>30</defaultValue>
		<description>Payment window length in days for MRU / Registration Fee eligibility</description>
	</globalProperty>
	<globalProperty>
		<property>ethbahmnicore.odoo.host</property>
		<defaultValue>localhost</defaultValue>
		<description>Odoo hostname for registration-fee invoice lookup (non-secret)</description>
	</globalProperty>
	<globalProperty>
		<property>ethbahmnicore.odoo.port</property>
		<defaultValue>8069</defaultValue>
		<description>Odoo XML-RPC port</description>
	</globalProperty>
	<globalProperty>
		<property>ethbahmnicore.odoo.database</property>
		<defaultValue>odoo</defaultValue>
		<description>Odoo database name</description>
	</globalProperty>
	<globalProperty>
		<property>ethbahmnicore.registrationFee.shopName</property>
		<defaultValue>MRU</defaultValue>
		<description>Odoo sale.shop name for Registration Fee invoices</description>
	</globalProperty>
	<globalProperty>
		<property>ethbahmnicore.registrationFee.productNames</property>
		<defaultValue>Regular Registration Fee,Emergency Registration Fee</defaultValue>
		<description>Comma-separated OpenMRS/Odoo product concept names treated as Registration Fee</description>
	</globalProperty>
	<globalProperty>
		<property>ethbahmnicore.registrationFee.orderTypeName</property>
		<defaultValue>Registration Fee</defaultValue>
		<description>OpenMRS order type name allowed without eligibility (billing flow)</description>
	</globalProperty>
	<globalProperty>
		<property>ethbahmnicore.registrationFee.allowedEncounterTypes</property>
		<defaultValue>REG,Registration</defaultValue>
		<description>Comma-separated encounter type names allowed without eligibility (billing flow). Bahmni uses REG.</description>
	</globalProperty>
	
	<!-- Internationalization -->
	<!-- All message codes should start with @MODULE_ID@.* -->
	<messages>
		<lang>en</lang>
		<file>messages.properties</file>
	</messages>
	<messages>
		<lang>fr</lang>
		<file>messages_fr.properties</file>
	</messages>
	<messages>
		<lang>es</lang>
		<file>messages_es.properties</file>
	</messages>
	<!-- /Internationalization -->
	
</module>
